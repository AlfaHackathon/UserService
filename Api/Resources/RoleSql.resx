  <data name="GetDefaults" xml:space="preserve">
    <value>SELECT id, name, is_default, company_id, created_at
FROM roles
WHERE is_default
ORDER BY name</value>
  </data>
  <data name="GetDefaultsPlusCompany" xml:space="preserve">
    <value>SELECT id, name, is_default, company_id, created_at
FROM roles
WHERE is_default OR company_id = @companyId
ORDER BY is_default DESC, name</value>
  </data>
  <data name="GetByIdInCompany" xml:space="preserve">
    <value>SELECT id, name, is_default, company_id, created_at
FROM roles
WHERE id = @roleId AND (is_default OR company_id = @companyId)</value>
  </data>
  <data name="CreateCustom" xml:space="preserve">
    <value>INSERT INTO roles (id, name, is_default, company_id, created_at)
VALUES (@id, @name, false, @companyId, @createdAt)
RETURNING id, name, is_default, company_id, created_at</value>
  </data>
  <data name="DeleteCustom" xml:space="preserve">
    <value>DELETE FROM roles
WHERE id = @roleId AND NOT is_default AND company_id = @companyId</value>
  </data>
  <data name="AssignToUser" xml:space="preserve">
    <value>UPDATE users SET role_id = @roleId WHERE id = @userId</value>
  </data>
  <data name="CountUsersWithRole" xml:space="preserve">
    <value>SELECT COUNT(*) FROM users WHERE role_id = @roleId</value>
  </data>
  <data name="NameExists" xml:space="preserve">
    <value>SELECT EXISTS(SELECT 1
FROM roles
WHERE name = @name AND (is_default OR company_id = @companyId))</value>
